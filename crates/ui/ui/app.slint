// The three surfaces. Same pages and tokens everywhere; only the frame differs.
import { Tokens, Mode } from "@tokens";
import "fonts/Anton-Regular.ttf";
import "fonts/Barlow-Regular.ttf";
import "fonts/Barlow-SemiBold.ttf";
import { AppState, Feedback } from "state.slint";
import { Caption, Hit, Icon, Icons, Motion, Ring } from "kit.slint";
import { DeskHistory, DeskSessions, DeskSettings, DeskToday, FirstRunPage, PanelSetup, PanelStrap, PanelToday, PanelWeek, PanelYou } from "pages.slint";

export { AppState, Feedback, Mode }

// Number in the display face with its unit beside it.
component Reading inherits HorizontalLayout {
    in property <string> value;
    in property <string> unit;
    in property <bool> faint;
    spacing: 10px;
    alignment: start;
    Text {
        text: root.value;
        color: root.faint ? Tokens.ink3 : Tokens.ink;
        font-size: Tokens.type-heading;
        font-family: Tokens.font-display;
        vertical-alignment: bottom;
    }
    Caption {
        text: root.unit;
        vertical-alignment: bottom;
    }
}

// The WristXR watch card, 14 cm on the wrist. One glance answers one question: the ring with
// today's kcal inside; the session, active minutes and heart rate sit beside it.
// The card grows one line down (never up: the ring row stays put) for a hint or a warning, and
// fades to lime for a few seconds at the goal. The texture is the card at its tallest; below a
// short card it is transparent.
export component WatchView inherits Window {
    width: 560px;
    height: 324px;
    background: transparent;
    // Pointed at with the other hand: say what the trigger does.
    property <bool> pointed: AppState.cursor-visible;
    // 0 none, 1 open hint, 2 first use, 3 strap lost. Warnings win over hints.
    property <int> strip: AppState.hr-lost ? 3 : !AppState.panel-seen ? 2 : root.pointed ? 1 : 0;
    property <length> card-h: root.strip > 0 ? 324px : 232px;
    animate card-h {
        duration: Motion.slow;
        easing: cubic-bezier(0.23, 1, 0.32, 1);
    }
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: root.card-h;
        border-radius: Tokens.radius-card;
        background: root.pointed ? Tokens.surface : Tokens.bg;
        animate background {
            duration: Motion.fast;
            easing: ease-out;
        }
        clip: true;
        HorizontalLayout {
            x: 0;
            y: 0;
            width: parent.width;
            height: 232px;
            padding-left: Tokens.space-6;
            padding-right: Tokens.space-6;
            spacing: Tokens.space-6;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 184px;
                    height: 184px;
                    Ring {
                        progress: AppState.progress;
                        thickness: 14px;
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: AppState.kcal-text;
                            color: Tokens.ink;
                            font-size: Tokens.type-watch-big;
                            font-family: Tokens.font-display;
                            horizontal-alignment: center;
                        }
                        Caption {
                            text: AppState.goal-text;
                            color: AppState.goal-met ? Tokens.accent : Tokens.ink2;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 10px;
                horizontal-stretch: 1;
                // The pill names what is being counted; the dot means counting.
                HorizontalLayout {
                    alignment: start;
                    Rectangle {
                        height: 36px;
                        border-radius: 18px;
                        background: Tokens.raised;
                        min-width: pill.preferred-width;
                        max-width: 304px;
                        clip: true;
                        pill := HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: Tokens.space-2;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 12px;
                                    height: 12px;
                                    border-radius: 6px;
                                    background: AppState.tracking ? Tokens.accent : Tokens.ink3;
                                }
                            }
                            Text {
                                text: AppState.tracking && AppState.game-name != "" ? AppState.game-name : AppState.tracking ? "Counting" : "Not counting";
                                color: AppState.tracking ? Tokens.ink : Tokens.ink2;
                                font-size: Tokens.type-small;
                                font-family: Tokens.font-body;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }
                Reading {
                    value: AppState.active-value;
                    unit: "min active";
                }
                if AppState.hr-shown: Reading {
                    value: AppState.hr-value;
                    unit: AppState.hr-label;
                    faint: !AppState.hr-live;
                }
                if !AppState.hr-shown && !AppState.tracking: Caption {
                    text: "Starts when you play";
                    color: Tokens.ink3;
                }
            }
        }
        // One line under the numbers for a hint or a warning (WristXR's low-battery strip).
        Rectangle {
            x: 12px;
            y: 232px;
            width: parent.width - 24px;
            height: 68px;
            border-radius: 18px;
            background: root.strip == 3 ? Tokens.danger-bg : root.strip == 2 ? Tokens.line : Tokens.raised;
            opacity: root.strip > 0 ? 1 : 0;
            animate opacity {
                duration: Motion.fade;
                easing: ease-out;
            }
            HorizontalLayout {
                padding-left: 18px;
                padding-right: 18px;
                spacing: 14px;
                VerticalLayout {
                    alignment: center;
                    if root.strip == 2: Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 11px;
                        background: Tokens.accent;
                        Icon {
                            d: Icons.down;
                            width: 24px;
                            height: 24px;
                            color: Tokens.on-accent;
                        }
                    }
                    if root.strip != 2: Icon {
                        d: root.strip == 3 ? Icons.warn : Icons.arrow;
                        color: root.strip == 3 ? Tokens.danger-ink : Tokens.accent;
                    }
                }
                Text {
                    text: root.strip == 3 ? "Strap lost · counting from movement" : root.strip == 2 ? "Point here, then pull the trigger" : "Pull the trigger to open the panel";
                    color: root.strip == 3 ? Tokens.danger-ink : Tokens.ink;
                    font-size: Tokens.type-small;
                    font-family: Tokens.font-body;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }
        }
        // Goal reached: the whole card turns lime for a few seconds.
        Rectangle {
            // Own corners: the software renderer clips children to the card's box, not its radius.
            border-radius: Tokens.radius-card;
            background: Tokens.accent;
            opacity: AppState.celebrate ? 1 : 0;
            animate opacity {
                duration: Motion.fade;
                easing: ease-out;
            }
            VerticalLayout {
                alignment: center;
                spacing: 6px;
                Text {
                    text: "GOAL";
                    color: Tokens.on-accent;
                    font-size: Tokens.type-watch-huge;
                    font-family: Tokens.font-display;
                    horizontal-alignment: center;
                }
                Text {
                    text: AppState.celebrate-text;
                    color: Tokens.on-accent;
                    font-size: Tokens.type-stat;
                    font-family: Tokens.font-body;
                    horizontal-alignment: center;
                }
            }
        }
    }
}

// A rail tab: icon in a pill (lime when chosen) over its name.
component RailTab inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> on;
    callback clicked();
    height: 88px;
    border-radius: Tokens.radius-group;
    background: hit.pressed && !root.on ? Tokens.pressed : hit.has-hover && !root.on ? Tokens.line : transparent;
    animate background {
        duration: hit.pressed ? 0ms : Motion.fast;
        easing: ease-out;
    }
    VerticalLayout {
        alignment: center;
        spacing: 6px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 56px;
                height: 40px;
                border-radius: 20px;
                background: root.on ? Tokens.accent : transparent;
                animate background {
                    duration: Motion.fast;
                    easing: ease-out;
                }
                Icon {
                    d: root.icon;
                    color: root.on ? Tokens.on-accent : Tokens.ink2;
                }
            }
        }
        Text {
            text: root.label;
            color: root.on ? Tokens.ink : Tokens.ink2;
            font-size: Tokens.type-small;
            font-family: Tokens.font-body;
            font-weight: root.on ? 600 : 400;
            horizontal-alignment: center;
        }
    }
    hit := Hit {
        clicked => {
            root.clicked();
        }
    }
}

// The WristXR rail menu, 50 cm wide at arm's length, opened from the watch.
export component PanelView inherits Window {
    in-out property <int> tab;
    width: 800px;
    height: 600px;
    background: transparent;
    Rectangle {
        border-radius: Tokens.radius-panel;
        background: Tokens.bg;
        clip: true;
        if AppState.first-run: FirstRunPage { }
        if !AppState.first-run: HorizontalLayout {
            Rectangle {
                width: 120px;
                background: Tokens.surface;
                VerticalLayout {
                    padding-top: Tokens.space-3;
                    padding-bottom: Tokens.space-3;
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: Tokens.space-1;
                    for t[i] in [
                        { label: "Today", icon: Icons.today },
                        { label: "Week", icon: Icons.week },
                        { label: "You", icon: Icons.you },
                        { label: "Strap", icon: Icons.strap },
                        { label: "Setup", icon: Icons.setup },
                    ]: RailTab {
                        label: t.label;
                        icon: t.icon;
                        on: i == root.tab;
                        clicked => {
                            root.tab = i;
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                    }
                    close := Rectangle {
                        height: 64px;
                        border-radius: Tokens.radius-group;
                        background: close-hit.pressed ? Tokens.dim : close-hit.has-hover ? Tokens.pressed : Tokens.raised;
                        animate background {
                            duration: close-hit.pressed ? 0ms : Motion.fast;
                            easing: ease-out;
                        }
                        Icon {
                            d: Icons.close;
                        }
                        close-hit := Hit {
                            clicked => {
                                AppState.close-panel();
                            }
                        }
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding-top: Tokens.space-5;
                    padding-bottom: Tokens.space-5;
                    padding-left: Tokens.space-6;
                    padding-right: Tokens.space-6;
                    if root.tab == 0: PanelToday { }
                    if root.tab == 1: PanelWeek { }
                    if root.tab == 2: PanelYou { }
                    if root.tab == 3: PanelStrap { }
                    if root.tab == 4: PanelSetup { }
                }
            }
        }
    }
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> on;
    // Icon only, for a narrow window.
    in property <bool> compact;
    callback clicked();
    // Named for screen readers, which matters most when only the icon shows.
    accessible-role: tab;
    accessible-label: root.label;
    accessible-item-selected: root.on;
    accessible-action-default => {
        root.clicked();
    }
    height: 44px;
    border-radius: Tokens.radius-control;
    background: root.on ? Tokens.raised : hit.pressed ? Tokens.line : hit.has-hover ? Tokens.raised : transparent;
    animate background {
        duration: hit.pressed ? 0ms : Motion.fast;
        easing: ease-out;
    }
    HorizontalLayout {
        padding-left: Tokens.space-3;
        padding-right: Tokens.space-3;
        spacing: Tokens.space-3;
        alignment: root.compact ? center : stretch;
        VerticalLayout {
            alignment: center;
            Icon {
                d: root.icon;
                width: 20px;
                height: 20px;
                color: root.on ? Tokens.accent : Tokens.ink2;
            }
        }
        if !root.compact: Text {
            text: root.label;
            color: root.on ? Tokens.ink : Tokens.ink2;
            font-size: Tokens.type-body;
            font-family: Tokens.font-body;
            font-weight: root.on ? 600 : 400;
            vertical-alignment: center;
        }
    }
    hit := Hit {
        clicked => {
            root.clicked();
        }
    }
}

export component DesktopWindow inherits Window {
    in-out property <int> tab;
    // Below this the sidebar shows icons only and pages stack into one column.
    out property <bool> narrow: self.width < 1024px;
    title: "SweatXR";
    icon: @image-url("../../../packaging/brand/sweatxr-256.png");
    preferred-width: 1200px;
    preferred-height: 800px;
    // Small enough to snap side by side on a 1440p screen at 150% and to fit a 1080p laptop.
    min-width: 760px;
    min-height: 520px;
    background: Tokens.bg;
    if AppState.first-run: FirstRunPage { }
    if !AppState.first-run: HorizontalLayout {
        Rectangle {
            width: root.narrow ? 72px : 216px;
            background: Tokens.surface;
            VerticalLayout {
                padding-top: Tokens.space-5;
                padding-bottom: Tokens.space-5;
                padding-left: Tokens.space-3;
                padding-right: Tokens.space-3;
                spacing: Tokens.space-1;
                HorizontalLayout {
                    padding-left: root.narrow ? 0 : Tokens.space-3;
                    padding-top: Tokens.space-1;
                    padding-bottom: Tokens.space-5;
                    spacing: Tokens.space-2;
                    alignment: root.narrow ? center : start;
                    // The mark in the theme's accent, as tall as the wordmark's capitals.
                    Image {
                        source: @image-url("../../../packaging/brand/sweatxr-mark.svg");
                        colorize: Tokens.accent;
                        width: Tokens.type-brand * 1.15;
                        height: self.width;
                        y: (parent.height - self.height) / 2;
                    }
                    if !root.narrow: Text {
                        vertical-alignment: center;
                        text: "SWEATXR";
                        color: Tokens.ink;
                        font-size: Tokens.type-brand;
                        font-family: Tokens.font-display;
                    }
                }
                for t[i] in [
                    { label: "Today", icon: Icons.today },
                    { label: "History", icon: Icons.week },
                    { label: "Sessions", icon: Icons.sessions },
                    { label: "Settings", icon: Icons.setup },
                ]: NavItem {
                    label: t.label;
                    icon: t.icon;
                    compact: root.narrow;
                    on: i == root.tab;
                    clicked => {
                        root.tab = i;
                        flick.content-y = 0;
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                }
                if !root.narrow: HorizontalLayout {
                    padding-left: Tokens.space-3;
                    padding-right: Tokens.space-3;
                    Text {
                        text: "Calories are estimates.\nNot a medical device.";
                        color: Tokens.ink3;
                        font-size: Tokens.type-small;
                        font-family: Tokens.font-body;
                        wrap: word-wrap;
                    }
                }
            }
        }
        // Pages fill the window when it is tall enough and scroll when it is not.
        Rectangle {
            horizontal-stretch: 1;
            flick := Flickable {
                content-width: self.width;
                content-height: max(self.height, page.min-height);
                page := VerticalLayout {
                    width: flick.width;
                    height: flick.content-height;
                    padding-top: 28px;
                    padding-bottom: 28px;
                    padding-left: root.narrow ? 24px : 36px;
                    padding-right: root.narrow ? 24px : 36px;
                    if root.tab == 0: DeskToday {
                        narrow: root.narrow;
                    }
                    if root.tab == 1: DeskHistory {
                        narrow: root.narrow;
                    }
                    if root.tab == 2: DeskSessions { }
                    if root.tab == 3: DeskSettings {
                        narrow: root.narrow;
                    }
                }
            }
            if flick.content-height > flick.height + 1px: Rectangle {
                x: parent.width - 8px;
                width: 4px;
                border-radius: 2px;
                background: Tokens.edge;
                height: max(32px, flick.height * flick.height / flick.content-height);
                y: (flick.height - self.height) * (-flick.content-y) / (flick.content-height - flick.height);
            }
        }
    }
}
