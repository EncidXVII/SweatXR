// The three surfaces. Same pages and tokens everywhere; only the frame differs.
import { Tokens, Mode } from "@tokens";
import "fonts/Anton-Regular.ttf";
import "fonts/Ubuntu-Regular.ttf";
import { AppState, Feedback } from "state.slint";
import { Button, Caption, Cursor, Ring, TabBar } from "kit.slint";
import { FirstRunPage, HistoryPage, SessionsPage, SettingsPage, TodayPage } from "pages.slint";

export { AppState, Feedback, Mode }

component Footer inherits Caption {
    text: "Calories are estimates. Not a medical device.";
    color: Tokens.ink3;
}

// Number in the display face with a small unit.
component Reading inherits HorizontalLayout {
    in property <string> value;
    in property <string> unit;
    in property <bool> live;
    spacing: Tokens.space-1;
    alignment: start;
    Text {
        text: root.value;
        color: root.live ? Tokens.accent : Tokens.ink;
        font-size: Tokens.type-watch-small;
        font-family: Tokens.font-display;
        vertical-alignment: bottom;
    }
    Caption {
        text: root.unit;
        vertical-alignment: bottom;
    }
}

// 8 cm on the wrist. One glance answers one question: the ring with today's kcal inside.
// Secondary readings sit to the side for a second look.
export component WatchView inherits Window {
    width: 512px;
    height: 320px;
    background: Tokens.bg;
    if !AppState.celebrate: HorizontalLayout {
        padding: Tokens.space-5;
        spacing: Tokens.space-5;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 272px;
                height: 272px;
                Ring {
                    progress: AppState.progress;
                    thickness: 20px;
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: AppState.kcal-text;
                        color: Tokens.ink;
                        font-size: Tokens.type-watch-big;
                        font-family: Tokens.font-display;
                        horizontal-alignment: center;
                    }
                    Caption {
                        text: "KCAL EST.";
                        horizontal-alignment: center;
                    }
                }
            }
        }
        if !AppState.panel-seen: Caption {
            // Shown until the panel has been opened once: the gesture is not guessable.
            text: "POINT HERE AND PULL THE TRIGGER";
            color: Tokens.accent;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
        if AppState.panel-seen: VerticalLayout {
            alignment: center;
            spacing: Tokens.space-3;
            if AppState.tracking: HorizontalLayout {
                spacing: Tokens.space-2;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: Tokens.space-3;
                        height: Tokens.space-3;
                        border-radius: self.width / 2;
                        background: Tokens.accent;
                    }
                }
                Caption {
                    text: "LIVE";
                    color: Tokens.accent;
                }
            }
            Reading {
                value: AppState.active-value;
                unit: "MIN";
            }
            if AppState.hr-shown: Reading {
                value: AppState.hr-value;
                unit: "BPM";
                live: AppState.hr-live;
            }
            if AppState.hr-zone != "": Caption {
                text: AppState.hr-zone;
            }
        }
    }
    // Goal reached: the whole face turns lime for a few seconds.
    if AppState.celebrate: Rectangle {
        background: Tokens.accent;
        VerticalLayout {
            alignment: center;
            Text {
                text: "GOAL";
                color: Tokens.on-accent;
                font-size: Tokens.type-watch-big;
                font-family: Tokens.font-display;
                horizontal-alignment: center;
            }
            Text {
                text: AppState.kcal-text + " KCAL";
                color: Tokens.on-accent;
                font-size: Tokens.type-watch-small;
                font-family: Tokens.font-display;
                horizontal-alignment: center;
            }
        }
    }
    Cursor { }
}

// 0.8 m wide at 0.7 m, opened from the watch.
export component PanelView inherits Window {
    in-out property <int> tab;
    width: 1200px;
    height: 800px;
    background: Tokens.bg;
    if AppState.first-run: FirstRunPage { }
    if !AppState.first-run: VerticalLayout {
        padding: Tokens.space-7;
        spacing: Tokens.space-6;
        HorizontalLayout {
            spacing: Tokens.space-6;
            TabBar {
                tabs: ["TODAY", "WEEK", "SETTINGS"];
                selected <=> root.tab;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            Button {
                text: "CLOSE";
                clicked => {
                    AppState.close-panel();
                }
            }
        }
        if root.tab == 0: TodayPage {
            vertical-stretch: 1;
        }
        if root.tab == 1: HistoryPage {
            vertical-stretch: 1;
        }
        if root.tab == 2: SettingsPage {
            vertical-stretch: 1;
        }
        Footer { }
    }
    Cursor { }
}

export component DesktopWindow inherits Window {
    in-out property <int> tab;
    title: "FitnessVR";
    preferred-width: 1200px;
    preferred-height: 800px;
    min-width: 1024px;
    min-height: 720px;
    background: Tokens.bg;
    if AppState.first-run: FirstRunPage { }
    if !AppState.first-run: VerticalLayout {
        padding: Tokens.space-7;
        spacing: Tokens.space-6;
        HorizontalLayout {
            alignment: start;
            TabBar {
                tabs: ["TODAY", "HISTORY", "SESSIONS", "SETTINGS"];
                selected <=> root.tab;
            }
        }
        if root.tab == 0: TodayPage {
            vertical-stretch: 1;
        }
        if root.tab == 1: HistoryPage {
            show-range: true;
            vertical-stretch: 1;
        }
        if root.tab == 2: SessionsPage {
            vertical-stretch: 1;
        }
        if root.tab == 3: SettingsPage {
            vertical-stretch: 1;
        }
        Footer { }
    }
}
